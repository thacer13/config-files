cproject() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: cproject <project_name> <module_name>"
        return 1 
    fi

    local PROJ_DIR=$1
    local MOD_NAME=$2

    echo "Creating project '$PROJ_DIR'..."

    mkdir -p "$PROJ_DIR"
    cd "$PROJ_DIR" || return 1

    cat << 'EOF' > Makefile
CC = gcc
CFLAGS = -Wall -Werror -std=c99
TARGET = app

SRCS = $(wildcard *.c)
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) $^ -o $@

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)
EOF

    # Replaced ^^ with a cross-shell compatible 'tr' command
    local HEADER_GUARD=$(echo "${MOD_NAME}_H" | tr '[:lower:]' '[:upper:]')
    
    cat << EOF > "${MOD_NAME}.h"
#ifndef ${HEADER_GUARD}
#define ${HEADER_GUARD}

#endif
EOF

    cat << EOF > "${MOD_NAME}.c"
#include "${MOD_NAME}.h"

EOF

    cat << EOF > main.c
#include <stdio.h>
#include "${MOD_NAME}.h"

int main(void) {
    printf("Hello, World!\n");
    return 0;
}
EOF

    echo "Done! You are now inside the '$PROJ_DIR' directory."
    echo "Type 'make' to build and './app' to run."
}
